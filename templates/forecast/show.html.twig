{% extends 'base.html.twig' %}

{% block title %}Forecast{% endblock %}

{% block body %}
    <h1>Forecast</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ forecast.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ forecast.date ? forecast.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Temperature</th>
                <td>{{ forecast.temperature }}</td>
            </tr>
            <tr>
                <th>Overcast</th>
                <td>{{ forecast.overcast }}</td>
            </tr>
            <tr>
                <th>Rain</th>
                <td>{{ forecast.rain }}</td>
            </tr>
            <tr>
                <th>Wind</th>
                <td>{{ forecast.wind }}</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <a class="btn btn-secondary" href="{{ path('app_forecast_index') }}">back to list</a>
        <a class="btn btn-primary" href="{{ path('app_forecast_edit', {'id': forecast.id}) }}">edit</a>
        {{ include('forecast/_delete_form.html.twig') }}
    </div>
{% endblock %}
